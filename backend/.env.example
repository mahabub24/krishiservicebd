PORT=5000
NODE_ENV=development

# --- Database: Supabase (PostgreSQL) ---
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# DATABASE_URL = pooled connection (Transaction pooler, port 6543) used by the running app.
# DIRECT_URL   = direct/session connection (port 5432) used by `prisma migrate`.
# Project ref: uiafnnhxmxsogaxzwxnl. Replace [PASSWORD] and [REGION] with your values.
DATABASE_URL="postgresql://postgres.uiafnnhxmxsogaxzwxnl:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.uiafnnhxmxsogaxzwxnl:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase API (not used for DB access; publishable key is safe for browsers only)
SUPABASE_URL="https://uiafnnhxmxsogaxzwxnl.supabase.co"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-generate-a-long-random-string"
JWT_EXPIRES_IN="7d"
COOKIE_DOMAIN=""
TRUST_PROXY="false"

# --- Web ---
# Comma-separated allow-list of browser origins
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
PUBLIC_API_URL="http://localhost:5000"

# --- Uploads (local dev). Swap for object storage in production (see README) ---
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="5"

# --- Optional notifications (leave empty to disable) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMS_API_URL=""
SMS_API_KEY=""

# --- Seeding (never commit real values) ---
SEED_ADMIN_PHONE="01700000000"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-before-seeding"
